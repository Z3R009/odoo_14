<odoo>

    <!-- pdf -->
    <report
        id="report_print_invoice"
        string="Print Invoice"
        model="read.meter"
        report_type="qweb-pdf"
        name="water_billing.print_invoice"
        file="water_billing.print_invoice"
    />

    <!-- html -->

    <report
        id="report_print_invoice_html"
        string="Print Invoice (HTML)"
        model="read.meter"
        report_type="qweb-html"
        name="water_billing.print_invoice"
    />

    <template id="print_invoice">
        <t t-call="web.html_container">
            <div class="page">

                <!-- HEADER -->
                <table style="width: 100%; margin-bottom: 20px; border-collapse: collapse;">
                    <tr>
                        <td style="width: 50px; vertical-align: middle;">
                            <img
                                t-att-src="('%s/water_billing/static/src/img/images.png' % env['ir.config_parameter'].sudo().get_param('web.base.url'))"
                                style="height: 70px;" />

                        </td>
                        <td style="vertical-align: middle; padding-left: 10px;">
                            <h2 style="margin: 0;">Water Billing Invoice</h2>
                        </td>
                    </tr>
                </table>

                <br />

                <!-- INVOICE DETAILS -->
                <table class="table table-sm table-bordered"
                    style="width:50%; border-collapse:collapse; font-size:14px;">
                    <tbody>
                        <t t-foreach="docs" t-as="doc">
                            <tr>
                                <td style="color:darkblue; padding:6px;">
                                    <strong style="color:blue;">Customer Name:</strong>
                                    <t t-esc="doc.member_id.name" style="color:green;" />
                                </td>
                                <td style="color:darkblue; padding:6px;">
                                    <strong style="color:blue;">Billing Date:</strong>
                                    <t t-esc="doc.billing_date" style="color:green;" />
                                </td>
                            </tr>

                            <tr>
                                <td colspan="2" style="padding:6px;">
                                    <h6 style="color:darkred;">Bill Information</h6>
                                    <table
                                        style="width:100%; border:1px solid #000; border-collapse:collapse;">
                                        <tr style="background-color:#f0f0f0;">
                                            <th style="padding:4px; color:#333;">Previous Reading</th>
                                            <th style="padding:4px; color:#333;">Current Reading</th>
                                            <th style="padding:4px; color:#333;">Usage</th>
                                        </tr>
                                        <tr>
                                            <td style="padding:4px; color:green;">
                                                <t t-esc="doc.previous_reading" />
                                            </td>
                                            <td style="padding:4px; color:green;">
                                                <t t-esc="doc.current_reading" />
                                            </td>
                                            <td style="padding:4px; color:green;">
                                                <t
                                                    t-esc="doc.usage" />
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="2" style="padding:6px; color:darkred;">
                                    <strong>Current Charges:</strong> ₱<t
                                        t-esc="doc.current_charges"
                                        style="color:green;" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" style="padding:6px; color:darkred;">
                                    <strong>Arrears:</strong> ₱<t t-esc="doc.arrears"
                                        style="color:green;" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" style="padding:6px; color:darkred;">
                                    <strong>Amount Due:</strong> ₱<t t-esc="doc.amount"
                                        style="color:green;" />
                                </td>
                            </tr>

                            <tr>
                                <td style="padding:6px; color:darkblue;">
                                    <strong>Due Date:</strong>
                                    <t t-esc="doc.due_date" />
                                </td>
                                <td style="padding:6px; color:darkblue;">
                                    <strong>Disconnection Date:</strong>
                                    <t t-esc="doc.disconnection_date" />
                                </td>
                            </tr>

                        </t>
                    </tbody>
                </table>

            </div>
        </t>

    </template>


</odoo>