<odoo>
    <!-- Billing History Tree -->
    <record id="view_payment_history_tree" model="ir.ui.view">
        <field name="name">payment.history.tree</field>
        <field name="model">payment.history</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="true">
                <field name="transaction_id" />
                <field name="reading_code" string="Reading ID" />
                <field name="member_id" />
                <field name="billing_date" />
                <field name="payment_date" />
                <field name="previous_reading" />
                <field name="current_reading" />
                <field name="usage" />
                <field name="amount" />
                <field name="payment_amount" />
                <field name="arrears" />
                <field name="paid" />
            </tree>
        </field>
    </record>


    <!-- payment history form -->
    <record id="view_payment_history_form" model="ir.ui.view">
        <field name="name">payment_history.form</field>
        <field name="model">payment.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="member_id" string="Customer Name" readonly="1"
                            style="font-size:20px; font-weight:bold; color: #black;" />
                    </group>
                    <group col="2">

                        <group>
                            <field name="reading_code"
                                readonly="1"
                            />
                            <field name="transaction_id" readonly="1" />
                        </group>

                        <group>
                            <field name="billing_date" readonly="1" />
                            <field name="payment_date" readonly="1" />
                        </group>
                    </group>

                    <group col="2">

                        <group>
                            <field name="usage" readonly="1" />
                            <field name="payment_amount" readonly="1" />
                            <field name="arrears" readonly="1" />
                            <field name="amount"
                                style="font-size:20px; font-weight:bold; color:black;" readonly="1" />
                        </group>

                        <group>
                            <field name="previous_reading" readonly="1" />
                            <field name="current_reading" readonly="1" />
                        </group>
                    </group>

                    <group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_payment_history" model="ir.actions.act_window">
        <field name="name">Payment History</field>
        <field name="res_model">payment.history</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- print -->
    <record id="action_payment_history_print" model="ir.actions.server">
        <field name="name">Print Payment History</field>
        <field name="model_id" ref="model_payment_history" />
        <field name="binding_model_id" ref="model_payment_history" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = env.ref('water_billing.action_payment_history_report').report_action(records)
        </field>
    </record>


    <!-- <record id="action_water_billing_history" model="ir.actions.act_window">
        <field name="name">Billing History (Paid)</field>
        <field name="res_model">water.billing</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('paid','=',True)]</field>
    </record> -->

    <!-- Menus -->
    <menuitem id="menu_water_billing_root" name="Water Billing" />

    <!-- First-level submenu -->
    <menuitem id="menu_payment_history"
        name="Payment History"
        parent="menu_water_billing_root"
        action="action_payment_history" />


    <!-- Second-level submenus -->
    <!-- <menuitem id="menu_water_billing_records" parent="menu_water_billing"
        name="Billing Records" action="action_water_billing" />


    <menuitem id="menu_water_billing_history" parent="menu_water_billing"
        name="Billing History (Paid)" action="action_water_billing_history" /> -->
</odoo>