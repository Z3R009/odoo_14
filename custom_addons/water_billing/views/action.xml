<odoo>


    <!-- Customer action -->
    <!-- <record id="action_water_members" model="ir.actions.act_window">
        <field name="name">Customer</field>
        <field name="res_model">water.member</field>
        <field name="view_mode">tree,form</field>
    </record> -->

    <!-- Read Meter action -->
    <record id="action_read_meter" model="ir.actions.act_window">
        <field name="name">Read Meter</field>
        <field name="res_model">read.meter</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- pay bills action -->

    <record id="action_pay_bills" model="ir.actions.act_window">
        <field name="name">Pay Bills</field>
        <field name="res_model">pay.bills</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', False)]</field>
    </record>

    <!-- payment history action -->

    <record id="action_payment_history" model="ir.actions.act_window">
        <field name="name">Payment History</field>
        <field name="res_model">payment.history</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- graph action -->

    <record id="action_water_usage_analysis" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">pay.bills</field>
        <field name="view_mode">pivot,graph</field>
        <field name="view_id" ref="view_water_usage_graph" /> <!-- default view -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Analyze water usage by member and billing date.
            </p>
        </field>
    </record>


    <!-- print Invoice -->

    <record id="a_action_print_invoice" model="ir.actions.server">
        <field name="name">Print Invoice</field>

        <!-- Bind to read.meter list view -->
        <field name="model_id" ref="model_read_meter" />
        <field name="binding_model_id" ref="model_read_meter" />
        <field name="binding_view_types">list</field>

        <field name="state">code</field>
        <field name="code">
            action = env.ref('water_billing.report_print_invoice').report_action(records)
        </field>
    </record>

    <!-- wizard -->

    <record id="action_generate_billing_wizard" model="ir.actions.act_window">
        <field name="name">Generate Billing</field>
        <field name="res_model">generate.billing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- billing period wizard -->

    <record id="action_generate_billing_period_wizard" model="ir.actions.act_window">
        <field name="name">Generate Billing Period</field>
        <field name="res_model">generate.billing.period.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>