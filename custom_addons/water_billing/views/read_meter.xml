<odoo>
    <!-- Billing Tree View -->
    <record id="view_read_meter_tree" model="ir.ui.view">
        <field name="name">read.meter.tree</field>
        <field name="model">read.meter</field>
        <field name="arch" type="xml">
            <tree>
                <field name="reading_id" />
                <field name="member_id" />
                <field name="billing_datetime" />
                <field name="previous_reading" />
                <field name="current_reading" />
                <field name="usage" />
                <field name="current_charges" />
                <field name="arrears" />
                <field name="amount" />
                <field name="state"
                    widget="badge"
                    decoration-warning="state == 'draft'"
                    decoration-success="state == 'confirmed'" />

            </tree>
        </field>
    </record>

    <!-- Billing Form View -->
    <record id="view_read_meter_form" model="ir.ui.view">
        <field name="name">read.meter.form</field>
        <field name="model">read.meter</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible':[('id','=',False),('state','!=','draft')]}" />
                    <field name="state" readonly="1"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed" />
                </header>
                <sheet>
                    <group>
                        <field name="reading_id"
                            style="font-size:20px; font-weight:bold; color: #black;"></field>
                    </group>

                    <group col="2">
                        <group>
                            <field name="member_id" string="Customer Name"
                                attrs="{'readonly':[('state','=','confirmed')]}" />
                            <field name="billing_datetime" invisible="1" />
                        </group>

                        <group>
                            <field name="previous_reading" readonly="1" />
                            <field name="current_reading" readonly="1" />
                            <!-- <field name="billing_month" readonly="1" />
                            <field name="start_date" readonly="1" /> -->
                        </group>
                    </group>

                    <group col="2">
                        <group>
                            <field name="usage"
                                attrs="{'readonly':[('state','=','confirmed')]}" />
                            <field name="current_charges" readonly="1" />
                            <field name="arrears" readonly="1" />
                            <field name="amount" readonly="1"
                                style="font-size:20px; font-weight:bold; color:black;" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>