<odoo>
    <record id="view_generate_billing_wizard_form" model="ir.ui.view">
        <field name="name">generate.billing.wizard.form</field>
        <field name="model">generate.billing.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Billing">
                <group>
                    <field name="start_date" />
                    <field name="end_date" />
                </group>
                <footer>
                    <button string="Generate"
                        name="action_generate_billing"
                        type="object"
                        class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>


</odoo>