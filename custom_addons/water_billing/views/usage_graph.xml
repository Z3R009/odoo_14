<odoo>
    <!-- Graph View -->
    <record id="view_water_usage_graph" model="ir.ui.view">
        <field name="name">pay.bills.graph</field>
        <field name="model">pay.bills</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="billing_date" type="row" interval="day" />
                <field name="usage" type="measure" />
                <field name="member_id" type="col" />
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_water_usage_pivot" model="ir.ui.view">
        <field name="name">pay.bills.pivot</field>
        <field name="model">pay.bills</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="billing_date" type="row" />
                <field name="member_id" type="col" />
                <field name="usage" type="measure" />
            </pivot>
        </field>
    </record>

</odoo>