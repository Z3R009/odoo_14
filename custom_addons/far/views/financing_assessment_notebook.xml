<odoo>

    <record id="view_financing_assessment_notebook" model="ir.ui.view">
        <field name="name">financing.assessment.form.notebook</field>
        <field name="model">financing.assessment</field>
        <field name="inherit_id" ref="far.view_financing_assessment_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook />
            </xpath>
        </field>
    </record>

</odoo>