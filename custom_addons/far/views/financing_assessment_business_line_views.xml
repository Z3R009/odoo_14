<odoo>
    <record id="view_business_line_tree" model="ir.ui.view">
        <field name="name">financing.assessment.business.line.tree</field>
        <field name="model">financing.assessment.business.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="business_type" />
                <field name="location" />
                <field name="employee_count" />
                <field name="cost_of_sales" />
                <field name="gross_sales" />
                <field name="total_sales" />
            </tree>
        </field>
    </record>
</odoo>