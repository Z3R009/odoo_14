<?xml version="1.0" encoding="UTF-8"?>


<odoo>
  <data>
    <record id="view_student_enrollment_form" model="ir.ui.view">
      <field name="name">student.enrollment.form</field>
      <field name="model">student.enrollment</field>
      <field name="arch" type="xml">
        <form string="Student Enrollment">
          <sheet>
            <group>
              <field name="first_name" />
              <field name="middle_name" />
              <field name="last_name" />
              <field name="email" />
              <field name="phone" />
              <field name="course" />
            </group>
          </sheet>
          <footer>
            <button name="%(action_report_student_enrollment)d"
              string="Print Report"
              type="action"
              class="btn-primary" />
          </footer>
        </form>
      </field>
    </record>

  </data>
</odoo>