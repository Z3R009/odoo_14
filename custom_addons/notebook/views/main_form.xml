<odoo>

    <record id="view_notebook_tree" model="ir.ui.view">
        <field name="name">notebook.tree</field>
        <field name="model">form.model</field>
        <field name="arch" type="xml">
            <tree string="Notebook Forms">
                <field name="partner_id" />
            </tree>
        </field>

    </record>

    <record id="view_notebook_form" model="ir.ui.view">
        <field name="name">form.model</field>
        <field name="model">form.model</field>
        <field name="arch" type="xml">
            <form string="FAR">

                <sheet>
                    <group>
                        <field name="partner_id" options="{'no_create': True, 'no_open': True}" />
                    </group>

                    <notebook>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>