<odoo>
    <record id="view_form_self_employed" model="ir.ui.view">
        <field name="name">income.form.self_employed</field>
        <field name="model">form.model</field>
        <field name="inherit_id" ref="notebook.view_notebook_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Self Employed">
                    <group>
                        <group>
                            <field name="self_employed_id">
                                <tree string="Self-Employed">
                                    <field name="nature_of_work" />
                                    <field name="years_of_experience" />
                                    <field name="average_income" />
                                </tree>
                                <form>
                                    <group>
                                        <field name="self_employed_form_id" invisible="1" />
                                        <field name="nature_of_work" />
                                        <field name="years_of_experience" />
                                        <field name="average_income" />
                                    </group>
                                </form>
                            </field>


                            <group colspan="4">
                                <div class="full-width-highlight o_right_align">
                                    <field name="self_employed_total_average_income"
                                        string="Total Average Income"
                                        readonly="1" />
                                </div>
                            </group>

                            <field name="self_employed_others_id">
                                <tree string="Others">
                                    <field name="nature_of_work_o" />
                                    <field name="years_of_experience_o" />
                                    <field name="average_income_o" />
                                </tree>
                                <form>
                                    <group>
                                        <field name="self_employed_form_id" invisible="1" />
                                        <field name="nature_of_work_o" />
                                        <field name="years_of_experience_o" />
                                        <field name="average_income_o" />
                                    </group>
                                </form>
                            </field>


                            <group colspan="4">
                                <div class="full-width-highlight o_right_align">
                                    <field name="self_employed_total_others_average_income"
                                        string="Total Others Average Income"
                                        readonly="1" />
                                </div>
                            </group>

                            <field name="self_employed_expense_id">
                                <tree string="Expenses">
                                    <field name="self_employed_expense_name" />
                                    <field name="self_employed_expense_amount" />
                                </tree>
                                <form>
                                    <group>
                                        <field name="self_employed_form_id" invisible="1" />
                                        <field name="self_employed_expense_name" />
                                        <field name="self_employed_expense_amount" />
                                    </group>
                                </form>
                            </field>


                            <group colspan="4">
                                <div class="full-width-highlight o_right_align">
                                    <field name="self_employed_total_expenses"
                                        string="Total Expenses"
                                        readonly="1" />
                                </div>
                            </group>
                        </group>

                    </group>
                    <group col="2">
                        <group>
                            <field name="self_employed_total_gross_income"
                                string="Total Gross Income" readonly="1" />
                            <field name="self_employed_total_expenses" string="Total Expenses"
                                readonly="1" />
                            <field name="self_employed_total_net_income"
                                string="Total Net Income" readonly="1" />
                        </group>
                        <group></group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>