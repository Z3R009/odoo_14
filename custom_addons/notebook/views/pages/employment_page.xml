<odoo>
    <record id="view_form_employment" model="ir.ui.view">
        <field name="name">income.form.employment</field>
        <field name="model">form.model</field>
        <field name="inherit_id" ref="notebook.view_notebook_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Employment">
                    <group>
                        <field name="employment_id">
                            <tree string="Employment">
                                <field name="company_name" />
                                <field name="employment_status" />
                                <field name="job_title" />
                                <field name="basic_monthly_salary" />
                                <field name="mandatory_deduction" />
                            </tree>
                            <form>
                                <group>
                                    <field name="employment_form_id" invisible="1" />
                                    <field name="company_name" />
                                    <field name="employment_status" />
                                    <field name="job_title" />
                                    <field name="basic_monthly_salary" />
                                    <field name="mandatory_deduction" />
                                </group>
                            </form>
                        </field>

                        <field name="employment_total_income" string="Total Income" readonly="1" />

                        <field name="employment_others_id">
                            <tree string="Others">
                                <field name="company_name_o" />
                                <field name="employment_status_o" />
                                <field name="job_title_o" />
                                <field name="basic_monthly_salary_o" />
                                <field name="mandatory_deduction_o" />
                            </tree>
                            <form>
                                <group>
                                    <field name="employment_form_id" invisible="1" />
                                    <field name="company_name_o" />
                                    <field name="employment_status_o" />
                                    <field name="job_title_o" />
                                    <field name="basic_monthly_salary_o" />
                                    <field name="mandatory_deduction_o" />
                                </group>
                            </form>
                        </field>

                        <field name="employment_total_others_income" string="Total Others Income"
                            readonly="1" />

                        <field name="employment_expense_id">
                            <tree string="Expenses">
                                <field name="employment_expense_name" />
                                <field name="employment_expense_amount" />
                            </tree>
                            <form>
                                <group>
                                    <field name="employment_form_id" invisible="1" />
                                    <field name="employment_expense_name" />
                                    <field name="employment_expense_amount" />
                                </group>
                            </form>
                        </field>

                        <field name="employment_total_expenses"
                            string="Total Expenses"
                            readonly="1" />

                    </group>

                    <group col="2">
                        <group>
                            <field name="employment_total_gross_income" string="Total Gross Income"
                                readonly="1" />
                            <field name="employment_total_expenses" string="Total Expenses"
                                readonly="1" />
                            <field name="employment_total_net_income" string="Total Net Income"
                                readonly="1" />
                        </group>
                        <group></group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>