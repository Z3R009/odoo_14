<odoo>
    <record id="view_financing_assessment_form" model="ir.ui.view">
        <field name="name">financing.assessment.form</field>
        <field name="model">financing.assessment</field>
        <field name="arch" type="xml">
            <form string="Financing Assessment">
                <sheet>

                    <notebook>

                        <page string="Farming">
                            <group>
                                <field name="crop_ids" />
                                <field name="livestock_ids" />
                            </group>
                        </page>

                        <page string="Business">
                            <group>
                                <field name="business_income" />
                                <field name="business_expense" />
                            </group>
                        </page>

                        <page string="Employment">
                            <group>
                                <field name="employer_name" />
                                <field name="monthly_salary" />
                            </group>
                        </page>

                        <page string="Others">
                            <group>
                                <field name="other_income" />
                            </group>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>